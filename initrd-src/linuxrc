#!/bin/sh
### linuxrc script by brokenman <http://www.porteus.org>
### modified for Debiandog by fredx181
# 2024-03-18 fredx181 modified for pseudo-full install

export PATH=/bin:/usr/bin:./

# Source functions
. ./finit

# Enable pivot_root in initramfs to let it behave like initrd:
if [ -d /m ]; then
    mount -nt tmpfs tmpfs -o mode=0755 /m
    cp -a ??* /m 2>/dev/null
    exec switch_root /m linuxrc "$@"
fi

mount -nt proc proc /proc
mount -nt sysfs sysfs /sys
echo 0 >/proc/sys/kernel/printk
# When the kernel needs a module it did not get told about - an nls table
# for a FAT mount, a cipher for dm-crypt, a filesystem named on a mount -
# it runs /sbin/modprobe, and this initrd has never had one: busybox's
# applets live in /bin. Give it one. Not by pointing the kernel at
# /bin/modprobe through /proc/sys/kernel/modprobe: that setting survives
# the pivot into the real root, where modprobe is in /sbin and /bin has
# none, and every module the kernel asked for on the running system -
# efivarfs, nls tables, ciphers - then failed to load, silently.
[ -e /sbin/modprobe ] || { mkdir -p /sbin; ln -s /bin/busybox /sbin/modprobe; }

echo "`cat /proc/cmdline|sed -e 's/^/ /'`" > /etc/cmdline
param() { egrep -qo " $1( |\$)" /etc/cmdline; }
value() { egrep -o " $1=[^ ]+" /etc/cmdline | cut -d= -f2; }
debug() { param debug && { echo -e "\n=====\n: Debugging started. Here is the shell for you.\n: Type your desired commands, hit Ctrl+D to continue booting\n: or press Ctrl+Alt+Del to reboot."; sh; echo -e "\n\n"; }; }

## Check for debug
if [ `grep -q debug /proc/cmdline` ]; then DBUG=0; fi

clear
echo -e "${BOLD}Starting init script.${RST}"

# Variables:
i=`echo "[1;33m""^ ""[0m"`
m=`echo "[1;33m""->""[0m"`
arch=`uname -m`; [ $arch = x86_64 ] || arch=i586
# Marker file used to locate the boot medium, searched for as live/$CFG.
# cfgfile= is the PorteuX spelling and wins if both are given; sgnfile= is the
# Porteus spelling for the same thing.  The default marker here is the initrd
# itself, not a .sgn file as on Porteus, so a Porteus boot line that relies on
# the default must name its marker explicitly.  A marker that cannot be found
# is fatal rather than silently ignored - see the 'fatal' script.
CFG=`value cfgfile`; [ $CFG ] || CFG=`value sgnfile`; [ $CFG ] || CFG=initrd1.xz
FROM=`value from`; ISO=`echo $FROM | egrep ".*\.iso( |\$)"`
IP=`value ip | cut -d: -f2`
NFSPATH=`value nfspath`; [ $NFSPATH ] || NFSPATH=/srv/pxe
# storage= (Porteus): where a netbooted client keeps its changes, exported by
# the same NFS server.  Derived from nfspath= so that changing the export root
# moves the storage with it; the default is the historical /srv/pxe/storage.
STORAGE=`value storage`; [ $STORAGE ] || STORAGE=$NFSPATH/storage
MOPT=`value mopt`; [ $MOPT ] || MOPT="noatime,nodiratime,suid,dev,exec,async"
# readonly : never write to a discovered filesystem.  Finding the boot medium
# means mounting every partition on the machine, and the default options are
# read-write, so an ordinary boot updates the superblock of every ext
# partition it finds and lets ntfs-3g write its log - before noauto unmounts
# anything.  This makes those mounts read-only instead.  Not spelled 'ro',
# which the kernel already defines.  Persistence needs a writable device, so a
# changes= given alongside this will fall back to memory.
#
# forensic goes further and sets the kernel's read-only flag on the devices
# themselves; it has to imply read-only mounts as well, because a read-write
# mount of a device the block layer has marked read-only simply fails, and the
# boot medium would never be found.
ROMOUNT=
param readonly && ROMOUNT=yes
param forensic && ROMOUNT=yes
[ "$ROMOUNT" ] && MOPT="ro,noatime,nodiratime"
export ROMOUNT
CHANGES=`value changes`
PFULL=`value pfull`
RAMSIZE=`value ramsize`; [ $RAMSIZE ] || RAMSIZE=60%
LOAD=`value load | sed 's/;/|/g'`; [ $LOAD ] || LOAD=._null
NOLOAD=`value noload | sed 's/;/|/g'`; [ $NOLOAD ] || NOLOAD=._null
EXTRAMOD=`value extramod | sed 's/;/ /g'`
RAMMOD=`value rammod | sed 's/;/|/g'`
ROOTCOPY=`value rootcopy`
FOLDER=live
livedbg=/var/log/livedbg
LOGFILE=/var/log/boot.log

## Let's start!
echo $i"loading kernel modules..."

MODPBLST=`value modprobe.blacklist | sed 's/,/|/g'`

if [ -n "$MODPBLST" ]; then
    sed -E "s/($MODPBLST) //g" -i modlist
    MODPBLST=`value modprobe.blacklist | sed 's/,/ /g;s/[_-]/?/g'`
    for MODULE in $MODPBLST; do
    find /lib/modules/$(uname -r)/kernel/ -name "$MODULE"'.*' -delete 2>/dev/null
    done
fi

if param nocd || [ $IP ]; then
    # nocd: no IDE/ATAPI drivers, so a machine with a slow or broken optical
    # drive is not probed. They are removed from the tree rather than from
    # the list, because the list no longer names them - the hardware pass
    # below would otherwise find them by PCI id.
    find /lib/modules/$(uname -r)/kernel/drivers/ata -name 'pata_*' -delete 2>/dev/null
fi

# Two passes over the module tree. First the list in modlist: filesystems,
# the block and USB storage classes, the HID basics - everything the union
# needs that no device announces. Then the hardware: every device the kernel
# has found so far carries a modalias in /sys, and modprobe resolves one to a
# driver through modules.alias exactly as udev will later. Drivers for
# hardware that is not present are never touched. That is what makes this
# cheaper than the old list of 200-odd names probed one by one - a machine
# announces a few dozen devices - and a boot medium behind an unusual
# controller still finds its driver, because the controller announced itself.
#
# The hardware pass runs twice. Loading a host controller (xhci, virtio-pci,
# hv_vmbus) makes the devices behind it appear with modaliases of their own,
# and those are only visible on the second pass, which loads only what is new.
load_by_modalias() {
    # Gather without forking: read and echo are builtins, and a laptop has a
    # few hundred of these files.
    : > /tmp/modalias.$1
    for A in /sys/bus/*/devices/*/modalias; do
        case "$A" in */bus/cpu/*) continue ;; esac
        read M < "$A" 2>/dev/null && echo "$M" >> /tmp/modalias.$1
    done
    sort -u /tmp/modalias.$1 > /tmp/modalias.$1.u
    if [ "$1" = 2 ] && [ -s /tmp/modalias.1 ]; then
        grep -vxF -f /tmp/modalias.1 /tmp/modalias.$1.u > /tmp/modalias.$1 2>/dev/null
    else
        mv /tmp/modalias.$1.u /tmp/modalias.$1
    fi
    # Only aliases that some shipped driver claims are handed to modprobe.
    # Most of what a machine announces (ACPI objects, platform devices, the
    # PCI bridges themselves) matches nothing, and each of those would be a
    # modprobe process that scans the index to say so. modules.alias holds
    # the patterns; turned into anchored regexes once, one grep does the
    # matching. If that grep fails outright the unfiltered list is used, so a
    # broken pattern costs time rather than a driver.
    # mkinitrd ships the pattern file ready-made as modules.alias.re; it is
    # built here only for an initrd that predates that.
    if [ ! -s /tmp/modalias.re ]; then
        if [ -s /lib/modules/$(uname -r)/modules.alias.re ]; then
            cp /lib/modules/$(uname -r)/modules.alias.re /tmp/modalias.re
        else
            sed -n 's/^alias \([^ ]*\) .*/\1/p' /lib/modules/$(uname -r)/modules.alias \
              | sed 's/[.^$+?()[{}|\\]/\\&/g; s/\]/\\]/g; s/\*/.*/g; s/^/^/; s/$/$/' > /tmp/modalias.re
        fi
    fi
    grep -E -f /tmp/modalias.re /tmp/modalias.$1 > /tmp/modalias.$1.hit 2>/dev/null
    [ $? -eq 2 ] && cp /tmp/modalias.$1 /tmp/modalias.$1.hit
    for M in `cat /tmp/modalias.$1.hit`; do modprobe "$M" 2>/dev/null; done
}

# SCSI scanning is asynchronous by default: modprobe of a disk controller
# returns while its ports are still being probed, and the block devices
# turn up some time later. The old list of a hundred-odd modprobes hid that
# by taking seconds; loading only what is present takes well under one,
# and fstab then enumerated the disks before they existed. scan=sync makes
# the controller's modprobe return only once its devices are known; it has
# to be set on scsi_mod before anything pulls that in as a dependency.
if param nohotplug; then
    echo $i"nohotplug - skipping automatic module loading"
else
    modprobe scsi_mod scan=sync 2>/dev/null
    for MODULE in $(cat modlist); do modprobe $MODULE 2>/dev/null; done
    load_by_modalias 1
    load_by_modalias 2
    # An SD card announces itself on the mmc bus only once the host
    # controller has scanned it, which can be after the second pass; the
    # block driver is loaded whenever a host controller turned up, so a
    # card in an internal reader is not missed.
    [ -n "$(ls /sys/class/mmc_host 2>/dev/null)" ] && modprobe mmc_block 2>/dev/null
    # USB storage and SD cards are enumerated by their host controllers on
    # their own schedule, which scan=sync does not cover. Wait for the set
    # of block devices to stop changing - half a second of no change, two
    # seconds at most - rather than a fixed time. delay= is still there for
    # a medium slower than that.
    LASTB=""; SAME=0; N=0
    while [ $N -lt 10 ]; do
        B=$(ls /sys/class/block 2>/dev/null | tr '\n' ' ')
        if [ "$B" = "$LASTB" ]; then SAME=$((SAME+1)); [ $SAME -ge 2 ] && break; else SAME=0; fi
        LASTB=$B; N=$((N+1)); sleep 0.2
    done
fi


mount -nt devtmpfs none /dev

# forensic : set the kernel read-only flag on every disk and partition, so the
# block layer refuses writes no matter what asks for them.  Done here, after
# /dev is populated and before fstab() mounts anything.  Loop, ram and
# device-mapper nodes are left alone: the initrd needs loop to mount the
# squashfs and any ISO or changes file.
#
# The name describes the intent, not a guarantee.  This is a kernel flag: root
# can clear it with blockdev --setrw, it does not cover SCSI passthrough, and
# blkid still reads every device to identify it.  It removes the writes an
# ordinary boot makes.  Evidence handling still wants a hardware write blocker.
if param forensic; then
    # PATH here is /bin:/usr/bin:./ and mkinitrd installs blockdev in /sbin, so
    # it has to be called by absolute path; a bare name silently fails to
    # resolve and every device is left writable.
    BD=
    for C in /sbin/blockdev /bin/blockdev /usr/sbin/blockdev /usr/bin/blockdev; do
	[ -x "$C" ] && { BD=$C; break; }
    done
    if [ "$BD" ]; then
	NRO=0
	echo -n $i"forensic - setting devices read-only:"
	for D in /sys/block/*; do
	    [ -d "$D" ] || continue
	    DN=`basename $D`
	    case $DN in loop*|ram*|zram*|dm-*|md*) continue ;; esac
	    # Partitions are the subdirectories carrying a 'partition' file.  A
	    # glob like $D/$DN* would expand to several paths at once and turn
	    # the [ -b ] test into a syntax error on any partitioned disk.
	    WBL=$DN
	    for PD in $D/*/partition; do
		[ -e "$PD" ] || continue
		# Parameter expansion, not `basename \`dirname ...\``: the initrd's
		# busybox has no dirname applet, so that pipeline yields nothing and
		# every partition is silently left writable.
		PP=${PD%/partition}
		WBL="$WBL ${PP##*/}"
	    done
	    for PN in $WBL; do
		[ -b /dev/$PN ] || continue
		# Shell arithmetic, not expr: the initrd's busybox is built without
		# the expr applet, so `expr` leaves NRO empty and the guard below
		# then errors out instead of reporting.
		"$BD" --setro /dev/$PN 2>/dev/null && { echo -n " $PN"; NRO=$((NRO+1)); }
	    done
	done
	echo
	# Protecting nothing must not look like success.
	[ "$NRO" -eq 0 ] && echo $i"[1;31m""forensic: no device could be set read-only - NOT protected""[0m"
	echo $i"[1;33m""kernel flag only - not a hardware write blocker""[0m"
    else
	echo $i"[1;31m""forensic: blockdev is missing from the initrd - NOT protected""[0m"
	sleep 5
    fi
fi

# Perform filesystem check:
if param fsck && [ "$ROMOUNT" ]; then
    echo $i"skipping fsck - readonly/forensic is in force and fsck must write"
elif param fsck; then
    echo $i"performing linux filesystem check on all available devices:"
    # fscknolog (PorteuX): still check, but keep the output off the console.
    # The log is stashed and appended to the boot log further down, so it
    # survives into /var/log/porteus-livedbg on the booted system.
    if param fscknolog; then
	run_fsck > /tmp/fsck.log 2>&1
	echo $i"filesystem check done - log kept for /var/log/porteus-livedbg"
    else
	draw
	run_fsck
	draw
    fi
fi

# Create /etc/fstab and mount devices:
fstab

debug
# Find *.cfg file:
echo $i"searching for $CFG file"
if [ $IP ]; then BOOTDEV=network; CFGDEV=/mnt/nfs
#   softdep for r8169 https://bugzilla.kernel.org/show_bug.cgi?id=204343
    lspci | grep 0200: >/tmp/lspci; grep -q 10ec: /tmp/lspci && modprobe realtek 2>/dev/null
    grep -q 14e4: /tmp/lspci && modprobe broadcom 2>/dev/null
    for x in `cut -d: -f3-4 /tmp/lspci | sed s/:/.*/g | tr a-z A-Z`; do modprobe `grep $x /lib/modules/$(uname -r)/modules.alias | tail -n1 | rev | cut -d" " -f1 | rev` 2>/dev/null; done
    ls /sys/class/net | grep -q eth || { for x in `find /lib/modules/$(uname -r)/kernel/drivers/net -name "*.ko" | sed 's/.ko//g'`; do modprobe `basename $x` 2>/dev/null; ls /sys/class/net | grep -q eth && break || modprobe -r `basename $x` 2>/dev/null; done; }
    mkdir -p /mnt/nfs/storage; udhcpc; modprobe nfsv4; mount -t nfs4 $IP:$NFSPATH /mnt/nfs -o ro,nolock 2>/dev/null || { modprobe nfsv3; mount -t nfs $IP:$NFSPATH /mnt/nfs -o ro,nolock 2>/dev/null; }
    # A netbooted client is identified by its MAC.  The old pipeline kept only
    # the last three octets, so two machines whose NICs share those would have
    # shared one changes directory; read the whole address from sysfs instead,
    # falling back to the old derivation if sysfs has nothing to offer.
    MACSHORT=`ifconfig | grep eth0 | cut -d: -f5-7 | sed s/://g | cut -d" " -f1`
    NETIF=eth0
    # sed, not head: the initrd's busybox has no head applet, so `head -1`
    # returns nothing and NETIF ends up empty on any machine whose first
    # interface is not called eth0.
    [ -e /sys/class/net/$NETIF/address ] || NETIF=`ls /sys/class/net 2>/dev/null | grep -v '^lo$' | sed -n 1p`
    MAC=`cat /sys/class/net/$NETIF/address 2>/dev/null | tr -d ':' | tr a-f A-F`
    [ "$MAC" ] || MAC=$MACSHORT
    # Netbooted changes go to the NFS-exported storage directory when the user
    # asks for it with storage=, or with the older changes=<storage path>.
    if [ "`value storage`" ] || [ "$CHANGES" = "$STORAGE" ]; then
	echo $i"using NFS storage $STORAGE for changes"
	if lsmod | grep -q nfsv3; then
	    mount -t nfs $IP:$STORAGE /mnt/nfs/storage -o rw,nolock 2>/dev/null && STORMNT=yes
	else
	    mount -t nfs4 $IP:$STORAGE /mnt/nfs/storage -o rw,nolock 2>/dev/null && STORMNT=yes
	fi
	if [ "$STORMNT" = yes ]; then
	    # Keep using a directory an older initrd created under the short name,
	    # so an existing client does not silently start from a fresh one.
	    CLIENT=client-$MAC
	    [ "$MACSHORT" ] && [ -d /mnt/nfs/storage/client-$MACSHORT ] && \
		[ ! -d /mnt/nfs/storage/client-$MAC ] && CLIENT=client-$MACSHORT
	    mkdir -p /mnt/nfs/storage/$CLIENT/changes/home
	    CHANGES="/storage/$CLIENT"
	    echo $i"client storage is $CLIENT"
	else
	    echo $i"could not mount $STORAGE - changes will stay in memory"
	fi
    fi
    if [ $FROM ]; then
        FOLDER=$FROM/live
    fi
elif [ $ISO ]; then CFGDEV=/mnt/isoloop
    locate -e $FROM && { BOOTDEV=/mnt/$DEV; mkdir /mnt/isoloop; mount -o loop /mnt/$DEV/$LPTH /mnt/isoloop; ISOSRC=/mnt/$DEV/$LPTH; }
else
    if [ $FROM ]; then
	locate -e $FROM/live/$CFG
	if [ $? -eq 0 ]; then
	    DIR=`echo $LPTH | rev | cut -d/ -f3- | rev`; [ $DIR ] && FOLDER=$DIR/live
	else
	    echo -e "${YELLOW}from= cheatcode is incorrect, press enter to search through all devices${RST}"
	    read -s; search -e live/$CFG
	fi
    else
	search -e live/$CFG || lazy -e live/$CFG
    fi
    CFGDEV=/mnt/$DEV
fi

[ -e $CFGDEV/$FOLDER/$CFG ] && PTH=$CFGDEV/$FOLDER || . fatal

# Set some variables to export as environment variables
DELAY=`value delay`; [ $DELAY ] && { echo $i"delaying $DELAY sec (waiting for slow devices to settle)"; sleep $DELAY; }
BOOTDEV=$CFGDEV
MODDIR=$PTH/modules
BASEDIR=${PTH%/*}
PORTDIR=$PTH
PORTCFG=$CFGDEV/$FOLDER/$CFG
echo $i"using data from $PTH"
echo  $PTH > /etc/homedrv
# Make all drivers available:
#mount -o loop $PTH/base/000-kernel.xzm /opt/000-kernel 2>/dev/null
#mount -o bind /opt/000-kernel/lib/modules /lib/modules 2>/dev/null

# Create symlinks used often by porteus scripts:
if [ $CFGDEV = /mnt/nfs -o $CFGDEV = /mnt/isoloop ];then
    ln -sf /mnt/live$PTH/modules  /porteus/modules
    ln -sf /mnt/live$PTH/optional /porteus/optional
else
    ln -sf $PTH/modules  /porteus/modules
    ln -sf $PTH/optional /porteus/optional
fi

debug
pos_fail () {
		rm -f /memory/changes/._test1 /memory/changes/._test2; umount /memory/changes
		echo && echo -e "[1;33m""A Windows filesystem (FAT, NTFS) or other non-posix compatible filesystem\nhas been detected on $CHANGES or $(echo $CHANGES |sed 's|\(.*\)/.*|\1|') .\nYour changes cannot be saved directly to the specified storage media with this\nsetup.""[0m"
		echo "press enter to continue in '[1;36mAlways Fresh[0m' mode for this session"
		read; rmdir /mnt/$DEV/$LPTH/changes 2>/dev/null; fail_chn
}

pos_fail1 () {
		rm -f /memory/changes/._test1 /memory/changes/._test2; umount /memory/changes
echo && echo -e "[1;33m""A Windows filesystem (FAT, NTFS) or other non-posix compatible filesystem\nhas been detected on $(echo $CHANGES |sed 's|\(.*\)/.*|\1|').\nYour changes cannot be saved directly to the specified storage media with this\nsetup.""[0m"
		echo "press enter to continue in '[1;36mAlways Fresh[0m' mode for this session"
		read; rmdir /mnt/$DEV/$LPTH/changes 2>/dev/null; fail_chn

}

# Setup changes:

if [ $PFULL ]; then
CHANGES=$PFULL
    echo $i"setting up directory for changes"
    CHNEXIT=`echo $CHANGES | cut -d: -f1`; 
    [ $CHNEXIT = EXIT ] && CHANGES=`echo $CHANGES | cut -d: -f2-`
    [ $CHNEXIT = +EXIT ] && CHANGES=`echo $CHANGES | cut -d: -f2-`   
    
    [ -r $CFGDEV/$CHANGES ] && { DEV=`echo $CFGDEV | sed s@/mnt/@@`; LPTH=$CHANGES; } || locate -r $CHANGES
    if [ $? -eq 0 ]; then
	if [ -d /mnt/$DEV/$LPTH/pfull/filesystem/var ] && [ -d /mnt/$DEV/$LPTH/pfull/filesystem/usr ] && [ -d /mnt/$DEV/$LPTH/pfull/filesystem/root ]; then
#	    mkdir -p /mnt/$DEV/$LPTH/changes 2>/dev/null && \
	    mount -o bind /mnt/$DEV/$LPTH/pfull /memory/changes && touch /memory/changes/._test1 2>/dev/null
	else
echo && echo
echo "[1;36m""Data not found for pseudo-full install /mnt/$DEV/$LPTH/pfull
Press space/enter to unmount all devices and reboot or any other key
to drop to the debug shell.""[0m"
read -s -n1 ans
if [ "$ans" = "" ]; then
    umount /mnt/* 2>/dev/null
    umount -a 2>/dev/null
    reboot -f
else
    echo -en "[1;36m""Here is debugging shell for you, unmount all partitions and press Ctrl+Alt+Del\nwhen you finish.\n\nGood luck!\n""[0m"
    sh
fi
	fi
	if [ $? -eq 0 ]; then
	    echo $i"testing filesystem on "$CHANGES" for posix compatibility"
	    ln -s /memory/changes/._test1 /memory/changes/._test2 2>/dev/null && chmod +x /memory/changes/._test1 2>/dev/null && [ -x /memory/changes/._test1 ] && chmod -x /memory/changes/._test1 2>/dev/null && [ ! -x /memory/changes/._test1 ] && rm -f /memory/changes/._test1 /memory/changes/._test2
ret=$? 
	    if [ $ret -ne 0 ]; then
            posfail=yes
            fi
if [ $CHNEXIT = +EXIT ];then
  if [ ! -d /mnt/$DEV/$LPTH ]; then
  APTH=$(echo /mnt/$DEV/$LPTH |sed 's|\(.*\)/.*|\1|')
    rm -f /memory/changes/._test1 /memory/changes/._test2; umount /memory/changes
#	    mkdir -p $APTH/changes 2>/dev/null && \
	    mount -o bind $APTH/pfull /memory/changes && touch /memory/changes/._test1 2>/dev/null
  else
    rm -f /memory/changes/._test1 /memory/changes/._test2; umount /memory/changes
#	    mkdir -p /mnt/$DEV/$LPTH/changes 2>/dev/null && \
	    mount -o bind /mnt/$DEV/$LPTH/pfull /memory/changes && touch /memory/changes/._test1 2>/dev/null
  fi
	    ln -s /memory/changes/._test1 /memory/changes/._test2 2>/dev/null && chmod +x /memory/changes/._test1 2>/dev/null && [ -x /memory/changes/._test1 ] && chmod -x /memory/changes/._test1 2>/dev/null && [ ! -x /memory/changes/._test1 ] && rm -f /memory/changes/._test1 /memory/changes/._test2
fi
ret1=$?

            if [ $ret -ne 0 ] && [ "$posfail" = "yes" ]; then
		rm -f /memory/changes/._test1 /memory/changes/._test2; umount /memory/changes
		echo && echo -e "[1;33m""A Windows filesystem (FAT, NTFS) or other non-posix compatible filesystem\nhas been detected on $CHANGES or $(echo $CHANGES |sed 's|\(.*\)/.*|\1|') .\nYour changes cannot be saved directly to the specified storage media with this\nsetup. Please use the '[1;36m Save file manager[1;33m' to create a .dat container\nand use it for saving your changes after your next reboot.""[0m"
		echo "boot will continue in '[1;36mAlways Fresh[0m' mode for this session"
		sleep 10; rmdir /mnt/$DEV/$LPTH/changes; fail_chn

            elif [ $ret1 -ne 0 ] && [ -z "$posfail" ]; then
		rm -f /memory/changes/._test1 /memory/changes/._test2; umount /memory/changes
echo && echo -e "[1;33m""A Windows filesystem (FAT, NTFS) or other non-posix compatible filesystem\nhas been detected on $(echo $CHANGES |sed 's|\(.*\)/.*|\1|').\nYour changes cannot be saved directly to the specified storage media with this\nsetup.""[0m"
		echo "press enter to continue in '[1;36mAlways Fresh[0m' mode for this session"
		read; rmdir /mnt/$DEV/$LPTH/changes 2>/dev/null; fail_chn

	    else
		echo $i"filesystem is posix compatible"; CHNDEV=/mnt/$DEV

        	if [ -f /memory/changes/clear-changes-on-reboot ]; then
                      echo $i"[1;36m""changes content signalled to be cleared""[0m"
                      rm -rf /memory/changes/*
		fi
	    	    	    
		if [ "$CHNEXIT" = EXIT -o "`egrep -o " changes-ro( |\$)" /proc/cmdline`" ]; then
		    CHNEXIT=$CHNDEV/$LPTH; echo $CHNEXIT >/tmp/changes-exit
		    param changes-ro && echo $i"[1;36m""changes will not be saved for this session""[0m" || echo $i"[1;36m""changes will be saved only during reboot/shutdown""[0m"

			setClean
			mkdir -p /memory/images/changes-exit
			mount -n --move /memory/changes /memory/images/changes-exit
			umount /memory/changes 2>/dev/null;
			mount -nt tmpfs -o size=$RAMSIZE tmpfs /memory/changes;
			CHANGES=memory
