export PATH=/bin:/usr/bin:./

# Source functions
. ./finit

# Enable pivot_root in initramfs to let it behave like initrd:
if [ -d /m ]; then
    mount -nt tmpfs tmpfs -o mode=0755 /m
    cp -a ??* /m 2>/dev/null
    exec switch_root /m linuxrc "$@"
fi

mount -nt proc proc /proc
mount -nt sysfs sysfs /sys
echo 0 >/proc/sys/kernel/printk

echo "`cat /proc/cmdline|sed -e 's/^/ /'`" > /etc/cmdline
param() { egrep -qo " $1( |\$)" /etc/cmdline; }
value() { egrep -o " $1=[^ ]+" /etc/cmdline | cut -d= -f2; }
debug() { param debug && { echo -e "\n=====\n: Debugging started. Here is the shell for you.\n: Type your desired commands, hit Ctrl+D to continue booting\n: or press Ctrl+Alt+Del to reboot."; sh; echo -e "\n\n"; }; }

## Check for debug
if [ `grep -q debug /proc/cmdline` ]; then DBUG=0; fi

clear
echo -e "${BOLD}Starting init script.${RST}"

# Variables:
i=`echo "[1;33m""^ ""[0m"`
m=`echo "[1;33m""->""[0m"`
arch=`uname -m`; [ $arch = x86_64 ] || arch=i586
# Marker file used to locate the boot medium, searched for as live/$CFG.
# cfgfile= is the PorteuX spelling and wins if both are given; sgnfile= is the
# Porteus spelling for the same thing.  The default marker here is the initrd
# itself, not a .sgn file as on Porteus, so a Porteus boot line that relies on
# the default must name its marker explicitly.  A marker that cannot be found
# is fatal rather than silently ignored - see the 'fatal' script.
CFG=`value cfgfile`; [ $CFG ] || CFG=`value sgnfile`; [ $CFG ] || CFG=initrd1.xz
FROM=`value from`; ISO=`echo $FROM | egrep ".*\.iso( |\$)"`
IP=`value ip | cut -d: -f2`
NFSPATH=`value nfspath`; [ $NFSPATH ] || NFSPATH=/srv/pxe
# storage= (Porteus): where a netbooted client keeps its changes, exported by
# the same NFS server.  Derived from nfspath= so that changing the export root
# moves the storage with it; the default is the historical /srv/pxe/storage.
STORAGE=`value storage`; [ $STORAGE ] || STORAGE=$NFSPATH/storage
MOPT=`value mopt`; [ $MOPT ] || MOPT="noatime,nodiratime,suid,dev,exec,async"
# readonly : never write to a discovered filesystem.  Finding the boot medium
# means mounting every partition on the machine, and the default options are
# read-write, so an ordinary boot updates the superblock of every ext
# partition it finds and lets ntfs-3g write its log - before noauto unmounts
# anything.  This makes those mounts read-only instead.  Not spelled 'ro',
# which the kernel already defines.  Persistence needs a writable device, so a
# changes= given alongside this will fall back to memory.
#
# writeblock goes further and sets the kernel's read-only flag on the devices
# themselves; it has to imply read-only mounts as well, because a read-write
# mount of a device the block layer has marked read-only simply fails, and the
# boot medium would never be found.
ROMOUNT=
param readonly && ROMOUNT=yes
param writeblock && ROMOUNT=yes
[ "$ROMOUNT" ] && MOPT="ro,noatime,nodiratime"
export ROMOUNT
CHANGES=`value changes`
PFULL=`value pfull`
RAMSIZE=`value ramsize`; [ $RAMSIZE ] || RAMSIZE=60%
LOAD=`value load | sed 's/;/|/g'`; [ $LOAD ] || LOAD=._null
NOLOAD=`value noload | sed 's/;/|/g'`; [ $NOLOAD ] || NOLOAD=._null
EXTRAMOD=`value extramod | sed 's/;/ /g'`
RAMMOD=`value rammod | sed 's/;/|/g'`
ROOTCOPY=`value rootcopy`
FOLDER=live
livedbg=/var/log/livedbg
LOGFILE=/var/log/boot.log

## Let's start!
echo $i"loading kernel modules..."

MODPBLST=`value modprobe.blacklist | sed 's/,/|/g'`

if [ -n "$MODPBLST" ]; then
    sed -E "s/($MODPBLST) //g" -i modlist
    MODPBLST=`value modprobe.blacklist | sed 's/,/ /g;s/[_-]/?/g'`
    for MODULE in $MODPBLST; do
    find /lib/modules/$(uname -r)/kernel/ -name "$MODULE"'.*' -delete 2>/dev/null
    done
fi

if param nocd || [ $IP ]; then
sed 's/pata_[0-9a-z]\{3,\} //g' -i modlist
fi

if param nohotplug; then
    echo $i"nohotplug - skipping automatic module loading"
else
for MODULE in $(cat modlist)
do
modprobe $MODULE 2> /dev/null
done
fi


mount -nt devtmpfs none /dev

# writeblock : set the kernel read-only flag on every disk and partition, so
# the block layer refuses writes no matter what asks for them.  Done here,
# after /dev is populated and before fstab() mounts anything.  Loop, ram and
# device-mapper nodes are left alone: the initrd needs loop to mount the
# squashfs and any ISO or changes file.
if param writeblock; then
    if [ -x /bin/blockdev ] || [ -x /sbin/blockdev ]; then
	echo -n $i"write-blocking devices:"
	for D in /sys/block/*; do
	    [ -d "$D" ] || continue
	    DN=`basename $D`
	    case $DN in loop*|ram*|zram*|dm-*|md*) continue ;; esac
	    # Partitions are the subdirectories carrying a 'partition' file.  A
	    # glob like $D/$DN* would expand to several paths at once and turn
	    # the [ -b ] test into a syntax error on any partitioned disk.
	    WBL=$DN
	    for PD in $D/*/partition; do
		[ -e "$PD" ] || continue
		WBL="$WBL `basename \`dirname $PD\``"
	    done
	    for PN in $WBL; do
		[ -b /dev/$PN ] || continue
		blockdev --setro /dev/$PN 2>/dev/null && echo -n " $PN"
	    done
	done
	echo
	echo $i"[1;33m""this is a kernel flag, not a hardware write blocker""[0m"
    else
	echo $i"[1;31m""writeblock: blockdev is missing from the initrd - NOT protected""[0m"
	sleep 5
    fi
fi

# Perform filesystem check:
if param fsck && [ "$ROMOUNT" ]; then
    echo $i"skipping fsck - readonly/writeblock is in force and fsck must write"
elif param fsck; then
    echo $i"performing linux filesystem check on all available devices:"
    # fscknolog (PorteuX): still check, but keep the output off the console.
    # The log is stashed and appended to the boot log further down, so it
    # survives into /var/log/porteus-livedbg on the booted system.
    if param fscknolog; then
	run_fsck > /tmp/fsck.log 2>&1
	echo $i"filesystem check done - log kept for /var/log/porteus-livedbg"
    else
	draw
	run_fsck
	draw
    fi
fi

