# systemd is the target on this branch.
#
# The Porteus lineage grew up on sysvinit and several cheatcodes used to be
# written in its terms - login= edited /etc/inittab, cliexec= hung off
# /etc/rc.local, nonetwork and friends chmod -x'd an init script. None of that
# does anything on a systemd system: there is no inittab to edit, /etc/rc.local
# is read only if rc-local.service happens to be shipped and its condition
# passes, and unit files are not shell scripts you can take the +x off.
#
# Those paths are gone rather than kept alongside. A cheatcode that silently
# writes a file nothing reads is worse than one that is absent, because it
# reports success.
if [ -x /union/lib/systemd/systemd ] || [ -x /union/usr/lib/systemd/systemd ]; then
	:
else
	echo -e "${RED}no systemd in the union - this initrd targets systemd only${RST}"
	echo -e "${YELLOW}the boot will continue, but the cheatcodes below will not apply${RST}"
	sleep 5
fi

# Where a unit lives, so it can be enabled or masked without systemctl running.
# /etc/systemd/system always wins over /lib and /usr/lib, which is what makes
# offline configuration possible at all: a symlink placed there is exactly what
# `systemctl enable` and `systemctl mask` would have created.
sd_unit_path() {   # UNIT -> prints the shipped unit file, or nothing
	for d in /union/lib/systemd/system /union/usr/lib/systemd/system \
	         /union/etc/systemd/system; do
		[ -f "$d/$1" ] && { echo "${d#/union}/$1"; return 0; }
	done
	return 1
}

sd_mask() {        # UNIT - stop it starting, the way `systemctl mask` does
	mkdir -p /union/etc/systemd/system 2>/dev/null
	ln -sf /dev/null "/union/etc/systemd/system/$1" 2>/dev/null
}

sd_unmask() {      # UNIT
	[ -L "/union/etc/systemd/system/$1" ] && rm -f "/union/etc/systemd/system/$1"
}

sd_enable() {      # UNIT [TARGET] - what `systemctl enable` writes
	U=$1; T=${2:-multi-user.target}
	P=`sd_unit_path "$U"` || return 1
	mkdir -p "/union/etc/systemd/system/$T.wants" 2>/dev/null
	ln -sf "$P" "/union/etc/systemd/system/$T.wants/$U" 2>/dev/null
}

sd_disable() {     # UNIT - remove the enable symlinks, leaving it startable
	rm -f /union/etc/systemd/system/*.target.wants/"$1" 2>/dev/null
}

