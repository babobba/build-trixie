# Where the old root goes when systemd is the target.
#
# Porteus pivots it to /mnt/live and that is all sysvinit needs. systemd wants
# it at /run/initramfs: at shutdown systemd looks there for an executable
# called `shutdown`, re-execs into it, and that script is what unmounts the
# union and the boot medium after the real root is gone. Without it systemd has
# nowhere to stand while tearing the union down, and the last unmounts fail.
#
# /mnt/live is kept as a symlink because a great deal already refers to it -
# the pxe cheatcode's generated server script, copy2ram, and every changes=
# path a user has ever written down.
setup_shutdown_root() {
	# The script goes in the INITRD's own root, not in /union/run/initramfs.
	# pivot_root moves the old root onto that directory, so anything written
	# there beforehand is hidden underneath the mount - which is exactly how
	# this was wrong first time round: the file was written, the boot worked,
	# and /run/initramfs/shutdown was missing in the booted system.
	#
	# After the pivot the initrd's / *is* /run/initramfs, so /shutdown here
	# lands at /run/initramfs/shutdown there, which is where systemd looks.
	# /run must be a mountpoint before the pivot, not merely a directory.
	#
	# systemd mounts a tmpfs on /run early in boot unless one is already there.
	# If we pivot the old root onto a plain directory in the overlay, that
	# tmpfs goes over the top and /run/initramfs - the old root, with the
	# shutdown script in it - disappears from the running system. The boot
	# still works, which is what makes this quiet: everything is fine until
	# the machine is switched off and the union cannot be unmounted.
	#
	# Mounting the tmpfs ourselves and pivoting into a directory inside it is
	# what LiveKit does, and it is the reason its shutdown script survives.
	mkdir -p /union/run 2>/dev/null
	mount -t tmpfs tmpfs /union/run 2>/dev/null
	mkdir -p /union/run/initramfs 2>/dev/null || return 1
	cat > /shutdown <<'SHUTDOWN'
#!/bin/sh
# Run by systemd from /run/initramfs after it has left the real root, so the
# union and the medium underneath it can be taken apart. Best effort by design:
# a failed unmount here must not stop the machine from powering off.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
ACTION=$1
umount -l /oldroot/memory/images/* 2>/dev/null
umount -l /oldroot/memory/changes  2>/dev/null
umount -l /oldroot                 2>/dev/null
losetup -D 2>/dev/null
case "$ACTION" in
	reboot)   reboot   -f ;;
	poweroff) poweroff -f ;;
	halt)     halt     -f ;;
	kexec)    kexec    -e 2>/dev/null; reboot -f ;;
	*)        poweroff -f ;;
esac
SHUTDOWN
	chmod +x /shutdown 2>/dev/null
	return 0
}

echo "[1m""live system is ready now - starting Debian""[0m"

# Hand off to systemd.
#
# The old script had four branches here - systemd or sysvinit, each with an
# init= override - which came from the days when this initrd had to serve both.
# One remains. systemd is found where Debian puts it, copied into the initrd's
# /bin so it survives the pivot, and exec'd as PID 1.
#
# init= is still honoured for anything else you might want as PID 1 (a shell,
# say, to debug a union that assembles but will not boot).
INIT_OVERRIDE=`value init`

SDBIN=
for c in /union/lib/systemd/systemd /union/usr/lib/systemd/systemd; do
	[ -x "$c" ] && { SDBIN=$c; break; }
done

if [ "$INIT_OVERRIDE" ] && [ "$INIT_OVERRIDE" != "/bin/systemd" ]; then
	echo -e "${YELLOW}init=$INIT_OVERRIDE given - starting that instead of systemd${RST}"
	setup_shutdown_root
	pivot_root /union /union/run/initramfs
	rm -rf mnt/live 2>/dev/null; mkdir -p mnt 2>/dev/null
	ln -sf /run/initramfs mnt/live 2>/dev/null
	exec usr/sbin/chroot . "$INIT_OVERRIDE" "$@" <dev/console >dev/console 2>&1
fi

if [ -z "$SDBIN" ]; then
	echo -e "${RED}!!ERROR!!${RST}"
	echo -e "${RED}No systemd found in the union. This initrd starts systemd and"
	echo -e "nothing else; a sysvinit image needs the initrd from the linuxrc"
	echo -e "branch instead.${RST}"
	echo -e "${YELLOW}Dropping to a shell. Ctrl+Alt+Del reboots.${RST}"
	sh
else
	cp -f "$SDBIN" /bin/systemd
	if [ $? -eq 0 ]; then
		setup_shutdown_root
		echo -e "${BOLD}using systemd...${RST}"
		# /run/initramfs, not /mnt/live: at shutdown systemd re-execs into
		# /run/initramfs/shutdown to unmount the union after the real root is
		# gone. Pivoting anywhere else leaves it with nowhere to stand.
		pivot_root /union /union/run/initramfs
		# Everything written before systemd support refers to /mnt/live.
		rm -rf mnt/live 2>/dev/null; mkdir -p mnt 2>/dev/null
		ln -sf /run/initramfs mnt/live 2>/dev/null
		exec usr/sbin/chroot . /run/initramfs/bin/systemd "$@" <dev/console >dev/console 2>&1
	else
		echo -e "${RED}!!ERROR!!\nCould not copy systemd into the initrd.\nPress Ctrl+Alt+Del to reboot.${RST}"
		sh
	fi
fi
