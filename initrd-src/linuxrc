# Everything collected above goes into one script, run before the graphical
# session starts.  It is called from two places because neither is sufficient:
#
#   - /etc/rc.local, which is where this kind of thing belongs, but runs as
#     S03 in the multiuser runlevel while inittab starts the tty1 autologin at
#     the same time, so startx can win the race;
#   - /etc/profile, immediately before its startx call, which is ordered by
#     construction but only covers the tty1 login path.
#
# The script takes a boot-scoped lock with mkdir, which is atomic, so whichever
# gets there first runs the commands and the other returns immediately.  That
# is what makes this the runlevel-3 equivalent Porteus documents: the commands
# have always run by the time X starts.
if [ -s $CHEATRC ]; then
	mkdir -p /union/usr/local/bin 2>/dev/null
