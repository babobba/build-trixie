	else
		echo 'XKBLAYOUT="'"$KMAP"'"' > /union/etc/default/keyboard
	fi
fi

# timezone= : e.g. timezone=Europe/Amsterdam
TZONE=`value timezone`
if [ "$TZONE" ]; then
	if [ -e "/union/usr/share/zoneinfo/$TZONE" ]; then
		echo $i"setting timezone to $TZONE"
