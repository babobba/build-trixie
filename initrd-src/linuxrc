# login=user / nologin : autologin.
# Two places, because either can be the one that matters: getty@tty1 for a
# text login, and the display manager for a graphical one. Drop-in files are
# used wherever supported, so packaged configuration is left alone.
DMNAME=`cat /union/etc/X11/default-display-manager 2>/dev/null`; DMNAME=${DMNAME##*/}
LOGINUSER=`value login`
if [ "$LOGINUSER" ]; then
	echo $i"autologin as $LOGINUSER"
	# The tty1 login is getty@tty1.service, and the supported way to change its
	# command line is a drop-in. The empty ExecStart= first is required:
	# without it systemd appends to the packaged one instead of replacing it,
	# and the unit fails to start with two ExecStart lines.
	mkdir -p /union/etc/systemd/system/getty@tty1.service.d 2>/dev/null
	cat > /union/etc/systemd/system/getty@tty1.service.d/90-autologin.conf <<AUTOLOGIN
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin $LOGINUSER --noclear %I \$TERM
AUTOLOGIN
	case "$DMNAME" in
	  slim)
		sed -i -e 's|^#*[ \t]*default_user.*|default_user        '"$LOGINUSER"'|' \
		       -e 's|^#*[ \t]*auto_login.*|auto_login          yes|' /union/etc/slim.conf 2>/dev/null
		grep -q '^default_user' /union/etc/slim.conf 2>/dev/null || \
			echo "default_user        $LOGINUSER" >> /union/etc/slim.conf
		grep -q '^auto_login' /union/etc/slim.conf 2>/dev/null || \
			echo "auto_login          yes" >> /union/etc/slim.conf ;;
	  lightdm)
		mkdir -p /union/etc/lightdm/lightdm.conf.d 2>/dev/null
		printf '[Seat:*]\nautologin-user=%s\nautologin-user-timeout=0\n' "$LOGINUSER" \
			> /union/etc/lightdm/lightdm.conf.d/90-autologin.conf ;;
	  sddm)
		mkdir -p /union/etc/sddm.conf.d 2>/dev/null
		printf '[Autologin]\nUser=%s\n' "$LOGINUSER" \
			> /union/etc/sddm.conf.d/90-autologin.conf ;;
	  gdm3|gdm)
		mkdir -p /union/etc/gdm3 2>/dev/null
		printf '[daemon]\nAutomaticLoginEnable=true\nAutomaticLogin=%s\n' "$LOGINUSER" \
			> /union/etc/gdm3/daemon.conf ;;
	  "") ;;
	  *) echo $i"login= : display manager $DMNAME is not known here - only the tty autologin was set" ;;
	esac
fi
if param nologin; then
	echo $i"disabling autologin"
	# Not just removing our own drop-in: the image ships its own
	# getty@tty1.service with "agetty -a root" baked in, so deleting the
	# drop-in would restore the image's autologin rather than disable it.
	# An explicit plain getty overrides whichever unit is underneath.
	mkdir -p /union/etc/systemd/system/getty@tty1.service.d 2>/dev/null
	cat > /union/etc/systemd/system/getty@tty1.service.d/90-autologin.conf <<'NOAUTOLOGIN'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --noclear %I 38400
NOAUTOLOGIN
	case "$DMNAME" in
	  slim)
		sed -i 's|^#*[ \t]*auto_login.*|auto_login          no|' /union/etc/slim.conf 2>/dev/null ;;
	  lightdm)
		mkdir -p /union/etc/lightdm/lightdm.conf.d 2>/dev/null
		printf '[Seat:*]\nautologin-user=\n' > /union/etc/lightdm/lightdm.conf.d/90-autologin.conf ;;
	  sddm)
		mkdir -p /union/etc/sddm.conf.d 2>/dev/null
		printf '[Autologin]\nUser=\nSession=\n' > /union/etc/sddm.conf.d/90-autologin.conf ;;
	  gdm3|gdm)
		mkdir -p /union/etc/gdm3 2>/dev/null
		printf '[daemon]\nAutomaticLoginEnable=false\n' > /union/etc/gdm3/daemon.conf ;;
	  "") ;;
	  *) echo $i"nologin : display manager $DMNAME is not known here - only the tty autologin was removed" ;;
	esac
fi

# volume= : master volume as a percentage
VOLUME=`value volume | tr -d '%'`
if [ "$VOLUME" ]; then
	echo $i"setting master volume to $VOLUME%"
	echo "amixer -q set Master ${VOLUME}% unmute 2>/dev/null || true" >> $CHEATRC
fi

# zram= : compressed swap sized as a percentage of RAM
ZRAM=`value zram | tr -d '%'`
if [ "$ZRAM" ]; then
	echo $i"enabling zram swap at $ZRAM% of RAM"
	cat >> $CHEATRC <<ZRAMEOF
modprobe zram num_devices=1 2>/dev/null || true
if [ -e /sys/block/zram0/disksize ]; then
  ZRKB=\`awk '/^MemTotal/{print \$2}' /proc/meminfo\`
  echo \$((ZRKB * $ZRAM / 100 * 1024)) > /sys/block/zram0/disksize 2>/dev/null
  mkswap /dev/zram0 >/dev/null 2>&1
  swapon -p 100 /dev/zram0 2>/dev/null || true
fi
