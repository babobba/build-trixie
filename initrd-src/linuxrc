# utc : hardware clock keeps UTC rather than local time
if param utc; then
	echo $i"hardware clock is UTC"
	printf '0.0 0 0.0\n0\nUTC\n' > /union/etc/adjtime
fi

# noupdateclock (PorteuX) : never write the hardware clock at boot/shutdown
if param noupdateclock; then
	echo $i"disabling hardware clock updates"
	# systemd has no hwclock.sh. The RTC is written by timesyncd on a good
	# sync and by systemd itself at shutdown; masking timesyncd stops the first.
	sd_mask systemd-timesyncd.service
