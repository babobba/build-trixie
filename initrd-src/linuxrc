#!/bin/sh
# generated from the cliexec=/volume=/zram= cheatcodes - rewritten at boot
BOOTID=`cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo nolock`
mkdir /tmp/.cliexec-cheat-$BOOTID 2>/dev/null || exit 0
CXHEAD
	cat $CHEATRC >> $CX
	echo "exit 0" >> $CX
	chmod +x $CX

	mkdir -p /union/etc/systemd/system 2>/dev/null
	cat > /union/etc/systemd/system/cliexec-cheat.service <<'CXUNIT'
[Unit]
Description=Commands from the cliexec= cheatcode
Documentation=man:bootparam(7)
# Before the graphical session, which is what cliexec= promises.
Before=display-manager.service graphical.target
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/cliexec-cheat
# A bad command in a cheatcode must not stop the boot.
SuccessExitStatus=0 1
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
CXUNIT
	sd_enable cliexec-cheat.service
fi

# default-target= / enable-services= / disable-services= (MiniOS).
#
# The systemd-native counterparts of the runlevel cheatcodes. Porteus has no
# equivalent because it has no targets; these come from MiniOS, which met the
# same problem porting this lineage to a systemd Debian and answered it by
# adding codes that speak systemd rather than by pretending inittab still
# exists.
#
# All three are written offline, as symlinks in /etc/systemd/system, which is
# exactly what systemctl enable/mask create. Nothing here needs systemd to be
# running, which it is not - this is still the initrd.
DEFTGT=`value default-target`
if [ "$DEFTGT" ]; then
	case "$DEFTGT" in *.target) ;; *) DEFTGT="$DEFTGT.target" ;; esac
	TP=`sd_unit_path "$DEFTGT"`
	if [ "$TP" ]; then
		echo $i"default target: $DEFTGT"
		ln -sf "$TP" /union/etc/systemd/system/default.target 2>/dev/null
	else
		echo $i"default-target: $DEFTGT is not installed - ignoring"
	fi
fi

ENSVC=`value enable-services | tr ',;' '  '`
for u in $ENSVC; do
	case "$u" in *.*) ;; *) u="$u.service" ;; esac
	if sd_unit_path "$u" >/dev/null; then
		echo $i"enabling $u"
		sd_unmask "$u"; sd_enable "$u"
	else
		echo $i"enable-services: $u is not installed - ignoring"
	fi
done

DISVC=`value disable-services | tr ',;' '  '`
for u in $DISVC; do
	case "$u" in *.*) ;; *) u="$u.service" ;; esac
	# Masked rather than disabled, so a unit pulled in as another unit's
	# dependency stays down too. Disabling alone would not achieve that,
	# and "disable-services" that leaves the service running is worse than
	# no cheatcode at all.
	echo $i"disabling $u"
	sd_disable "$u"; sd_mask "$u"
done

# guiexec= : run once the desktop is up.  The commands go into one script that
# is started two ways, because neither way covers every build on its own:
#
#   - an XDG autostart entry, which Xfce, Mate and LXQt honour directly;
#   - a line in each Openbox autostart file, because openbox-xdg-autostart
#     needs PyXDG and python3-xdg is not installed in a default image, so the
#     XDG entry alone would never fire on the default Openbox desktop.
#
# The script takes a lock with mkdir, which is atomic, so on a desktop that
# honours both mechanisms the commands still start exactly once.  The lock is
# keyed to the X session - see the script itself.
GUIEXEC=`value guiexec`
if [ "$GUIEXEC" ]; then
	echo $i"guiexec: $GUIEXEC"
	mkdir -p /union/etc/xdg/autostart /union/usr/local/bin 2>/dev/null
	GX=/union/usr/local/bin/guiexec-cheat
	cat > $GX <<'GXHEAD'
#!/bin/sh
# generated from the guiexec= cheatcode - do not edit, it is rewritten at boot
# The lock is keyed to the running X server, not to the boot, so that the two
# autostart mechanisms collapse to one run within a session while logging out
# and back in still starts the commands again, which is what "run when the
# graphical interface loads" should mean.  Falls back to the boot id if the X
# server cannot be identified.
GXSESSION=`pgrep -x Xorg 2>/dev/null | head -1`
[ "$GXSESSION" ] || GXSESSION=`cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo nolock`
mkdir /tmp/.guiexec-cheat-$GXSESSION 2>/dev/null || exit 0
GXHEAD
	echo "$GUIEXEC" | tr ';' '\n' | while read -r cmd; do
		[ "$cmd" ] && echo "`echo \"$cmd\" | tr '~' ' '` &" >> $GX
	done
	echo "exit 0" >> $GX
	chmod +x $GX
	cat > /union/etc/xdg/autostart/guiexec-cheat.desktop <<GXEOF
[Desktop Entry]
Type=Application
Name=guiexec cheatcode
Exec=/usr/local/bin/guiexec-cheat
NoDisplay=true
X-GNOME-Autostart-enabled=true
GXEOF
	for ashome in /union/root /union/home/*; do
		[ -d "$ashome/.config/openbox" ] || continue
		AS="$ashome/.config/openbox/autostart"
		echo "" >> "$AS"
		echo "# added by the guiexec= cheatcode" >> "$AS"
		echo "/usr/local/bin/guiexec-cheat &" >> "$AS"
	done
fi
