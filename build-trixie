echo -e "\e[0;36mOK, will create initrd.img\033[0m"
else
echo -e "\e[0;36mOK, will not create initrd.img, only initrd1.xz\033[0m"
fi

if [ $ISOUEFI = TRUE ]; then
echo -e "\e[0;33mAt the end an ISO will be created\033[0m" 
