echo -e "\e[0;33m gzip - quickest to compress, largest image\033[0m"
echo -e "\e[0;33m xz   - smallest image, much the slowest to compress, slowest to read at boot\033[0m"
echo -e "\e[0;33m zstd - close to xz in size, far quicker to compress and to read at boot\033[0m"
read -p "Type gzip, xz or zstd : " choice

case "$choice" in 
  gzip)
echo -e "\e[0;36mCreating kernel .squashfs isodata/live/k-$kernel${nmu}.squashfs . . .\033[0m"
mksquashfs $kernel isodata/live/k-$kernel${nmu}.squashfs
echo -e "\e[0;36mCreating isodata/live/01-filesystem.squashfs...\033[0m"
