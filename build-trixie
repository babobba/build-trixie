 apt-get install wget xz-utils squashfs-tools cpio xorriso isolinux gpgv mtools dosfstools -y
 ok_or_failed
fi

# (the Devuan keyring used to be installed here for a Devuan debootstrap;
#  both images are Debian now, so there is nothing for it to verify)

# install debootstrap deb # fredx181 2025-11-01, changed to devuan version
DEBOOTSTRAP=debootstrap_1.0.134devuan2_all.deb

dpkg -i "$DEBOOTSTRAP"

if [ -z `which debootstrap` ] || [ ! -e /usr/share/debootstrap/scripts/trixie ]; then
	msg=" You don't have debootstrap installed.\nIt's a dependency of this program.\n Please install it."
	echo $msg
	$MESSAGE "`echo -e $msg`"
exit 0
fi

if [ -z $(which dpkg) ] || [ -L $(which dpkg) ]; then
	msg=" You don't have the (full) package dpkg installed.\nIt's a dependency of this program.\n Please install it."
	echo $msg
	$MESSAGE "`echo -e $msg`"
exit 0
fi

########## Set up debootstrap ##########
# fredx181 2025-11-01, create devuan base system in case of non-systemd
echo -e "\e[0;36mSetting up debootstrap in trixie/chroot\033[0m"
echo -e "\e[0;36mThis may take a while...\033[0m"
mkdir -p trixie/chroot && cd trixie
# debootstrap fetches a few hundred packages and gives up on the first one it
# cannot get after its own single retry. A mirror that is merely flaky - one
# request in ten failing, which the Devuan merged mirror has been measured at -
# therefore fails most runs, and the only advice this script could offer was
# "please try again". So it tries again itself, up to three times, starting
# from an empty chroot each time since a half-populated one cannot be resumed.
ret=1
for attempt in 1 2 3; do
  [ $attempt -gt 1 ] && { echo -e "\e[0;33mdebootstrap attempt $attempt of 3 (the last one failed - usually a mirror hiccup)\033[0m"; rm -rf chroot; mkdir -p chroot; }
  # Debian trixie for both images. The one without systemd used to be Devuan
  # excalibur; it is now Debian with Debian's own sysvinit-core, which trixie
  # still ships, so the init choice is made after debootstrap rather than by
  # picking a different distribution.
  debootstrap --arch=$ARCH --variant=minbase --include=curl,apt-transport-https,ca-certificates,initscripts,adduser trixie chroot https://deb.debian.org/debian/
  ret=$?
  [ $ret -eq 0 ] && break
done
echo $ret
if [ $ret -ne 0 ]; then
echo -e "\e[0;31mFailed to install the base system\033[0m"
echo -e "\e[0;32mThis can happen sometimes, please try again, exiting now...\033[0m"
exit
fi

# create build_info.txt and build_setup.conf
cr_build_info

#[ "$ISOUEFI" = "TRUE" ] && tar -zxf ../isodata-trixie-uefi.tar.gz || tar -zxf ../isodata-trixie.tar.gz
[ "$ISOUEFI" = "TRUE" ] && cp -a ../isodata-uefi isodata || cp -a ../isodata isodata
ok_or_failed

mkdir -p isodata/live/rootcopy  # create it, as github doesn't support empty directories

#echo -e "\e[0;36mExtracting...\033[0m"
#tar -zxf ../dog-boot-trixie-20240602.tar.gz
echo -e "\e[0;36mCopy scripts, required for porteus-boot, to the chroot...\033[0m"
cp -af ../dog-boot-trixie-20240602/* chroot/
ok_or_failed

echo -e "\e[0;36mExtract initrd skeleton, required for porteus-boot, to chroot/tmp ...\033[0m"
tar -zxf ../initrdport-bullseye.tar.gz -C chroot/tmp
#cp -af initrdport-bullseye chroot/tmp/  # copy initrd skeleton to chroot/tmp/
ok_or_failed

# The boot scripts are kept as text in ../initrd-src so that changes to them
# are reviewable, instead of being buried in the binary skeleton archive.
# Everything else in the initrd (busybox, libs) still comes from the tarball.
echo -e "\e[0;36mOverlay initrd boot scripts from initrd-src...\033[0m"
cp -af ../initrd-src/linuxrc ../initrd-src/finit ../initrd-src/modlist chroot/tmp/initrdport-bullseye/
chmod +x chroot/tmp/initrdport-bullseye/linuxrc
ok_or_failed

echo -e "\e[0;36mCopy .deb packages from ../debs (if existing) to chroot/tmp/...\033[0m"
echo -e "\e[0;36mTo be installed at the end of the general install process\033[0m"
find ../debs -name *.deb -exec cp -af "{}" chroot/tmp/ \; 2> /dev/null

# copy 'extra-commands' script to chroot/tmp to be executed at the end of running in chroot
cp -a ../extra-commands chroot/tmp/

# mount bind some required directories from host filesystem
mount --bind /proc chroot/proc
#mount --bind /tmp chroot/tmp
mount --bind /dev chroot/dev
mount --bind /sys chroot/sys
mount -t devpts devpts chroot/dev/pts
# provide a network connection in chroot
echo -en "`cat /etc/resolv.conf`" > chroot/etc/resolv.conf

#################################################
############ Start running in chroot ############
#################################################
chroot_in () { 
if [ -z $(which apt-get) ]; then
echo -e "\e[0;31mSorry, apt-get not found, cannot continue\033[0m"
echo -e "\e[0;36mExiting . . .\033[0m"
touch /exit_
sleep 3
exit
fi 

export HOME=/root
export LC_ALL=C

# Google chrome for 64 bit only, so remove on i386
[ "$ARCH" = "i386" ] && rm -f /etc/apt/sources.list.d/google-chrome.list

# Setup install without install recommends
echo "APT::Install-Recommends "false"; APT::Install-Suggests "false";" > /etc/apt/apt.conf
echo "Acquire::Check-Valid-Until "0";" >> /etc/apt/apt.conf
echo "APT::Get::Allow-Downgrades "true";" >> /etc/apt/apt.conf

# No Devuan archive for either image. What keeps systemd out of the sysvinit
# image is the 00systemd pin shipped in the overlay, which names the init
# packages explicitly - libsystemd0 is just a library that most of the desktop
# links against and must stay installable.
DEVUANREPO=""

# repos for 64-bit
export REPOS64='deb [signed-by=/etc/apt/trusted.gpg.d/debdog.gpg] https://fred181.gitlab.io/trixie/amd64/ ./
## package repositories
deb https://deb.debian.org/debian trixie main contrib non-free non-free-firmware
#deb-src https://deb.debian.org/debian trixie main contrib non-free

'$DEVUANREPO'

deb https://deb.debian.org/debian trixie-updates main contrib non-free
#deb-src https://deb.debian.org/debian trixie-updates main contrib non-free

#deb https://deb.debian.org/debian trixie-proposed-updates main contrib non-free
#deb-src https://deb.debian.org/debian trixie-proposed-updates main contrib non-free

deb https://security.debian.org trixie-security main contrib non-free
#deb-src https://security.debian.org trixie-security main contrib non-free

'$SNAPSHOT'

'

# repos for 32-bit
export REPOS32='deb [signed-by=/etc/apt/trusted.gpg.d/debdog.gpg] https://fred181.gitlab.io/trixie/i386/ ./
## package repositories
deb https://deb.debian.org/debian trixie main contrib non-free non-free-firmware
#deb-src https://deb.debian.org/debian trixie main contrib non-free

'$DEVUANREPO'

deb https://deb.debian.org/debian trixie-updates main contrib non-free
#deb-src https://deb.debian.org/debian trixie-updates main contrib non-free

#deb https://deb.debian.org/debian trixie-proposed-updates main contrib non-free
#deb-src https://deb.debian.org/debian trixie-proposed-updates main contrib non-free

deb https://security.debian.org trixie-security main contrib non-free
#deb-src https://security.debian.org trixie-security main contrib non-free

'$SNAPSHOT'

'

[ "$ARCH" = "i386" ] && echo "$REPOS32" > /etc/apt/sources.list

[ "$ARCH" = "amd64" ] && echo "$REPOS64" > /etc/apt/sources.list 

######### Support for xlibre (replacement for xorg) #########
    if [ "$ARCH" = "amd64" ]; then  # ONLY for amd64
curl -fsSL https://xlibre-deb.github.io/key.asc > /etc/apt/keyrings/xlibre-deb.asc
chmod a+r /etc/apt/keyrings/xlibre-deb.asc
# A repository whose key did not arrive is worse than no repository: apt then
# fails on every update, in the build and afterwards in the built image, with
# "is not signed". The fetch can fail for ordinary reasons - no network in the
# chroot, a proxy that the chroot cannot reach - and it did so silently before
# this check, leaving a 0-byte keyring and an unsigned entry in
# sources.list.d.
