# Overrides /usr/lib/systemd/system/rc-local.service for one reason: that
# unit carries After=network.target, and Debian's drop-in adds
# After=network-online.target on top (see rc-local.service.d/debian.conf,
# also replaced here). getty@tty1 is ordered after rc.local, so both of
# those put networking.service - five seconds of ifup for interfaces this
# image does not configure - between the kernel and the login prompt.
# Nothing in this image's rc.local touches the network. Everything else is
# upstream's unit as shipped.
[Unit]
Description=/etc/rc.local Compatibility
Documentation=man:systemd-rc-local-generator(8)
ConditionFileIsExecutable=/etc/rc.local

[Service]
Type=forking
ExecStart=/etc/rc.local start
TimeoutSec=infinity
RemainAfterExit=yes
GuessMainPID=no
