# /etc/profile: system-wide .profile file for the Bourne shell (sh(1))
# and Bourne compatible shells (bash(1), ksh(1), ash(1), ...).

#if [ "`id -u`" -eq 0 ]; then
#PATH="/opt/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/#games:/usr/games"
#else
#PATH="/opt/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/#games:/usr/games"
# PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games"
#fi

PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/games:/usr/games:/opt/bin"
[ "`id -u`" -eq 0 ]&& PATH="$PATH:/usr/local/sbin:/usr/sbin:/sbin"

export PATH

if [ "$PS1" ]; then
  if [ "$BASH" ] && [ "$BASH" != "/bin/sh" ]; then
    # The file bash.bashrc already sets the default PS1.
    # PS1='\h:\w\$ '
    if [ -f /etc/bash.bashrc ]; then
      . /etc/bash.bashrc
    fi
  else
    if [ "`id -u`" -eq 0 ]; then
      PS1='# '
    else
      PS1='$ '
    fi
  fi
fi

# The default umask is now handled by pam_umask.
# See pam_umask(8) and /etc/login.defs.

if [ -d /etc/profile.d ]; then
  for i in /etc/profile.d/*.sh; do
    if [ -r $i ]; then
      . $i
    fi
  done
  unset i
fi

# startx straight away. There used to be a three-second sleep here, from the
# days when the tty1 login could race the rc scripts; under systemd getty@tty1
# is ordered after rc-local.service, and under sysvinit the runlevel's "wait"
# entries finish before its "respawn" ones start, so nothing is left to wait
# for on either.
if [ -z "${DISPLAY}" ] && [ $(tty) = /dev/tty1 ]
then
startx
fi

