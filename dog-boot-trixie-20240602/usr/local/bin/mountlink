#!/bin/bash
#set -x

export LANG=C
hdrv=$(cat /mnt/live/etc/homedrv | cut -d'/' -f3)
HDRV=$(cat '/var/log/porteus-livedbg' | grep -A1 "# Booting device:" | tail -n1)
#[ -d /mnt/live/$HDRV ] && ln -snf /mnt/live/$HDRV /mnt/home || ln -snf $HDRV /mnt/home

if grep -q noauto /proc/cmdline; then
mkdir -p /mnt/$hdrv
mount /dev/$hdrv /mnt/$hdrv
ln -snf $HDRV /mnt/home
else
  if [ "$(uname -m)" = "i686" ]; then
  mkdir -p /mnt/live/mnt/$hdrv
  mount /dev/$hdrv /mnt/live/mnt/$hdrv
  ln -snf $HDRV /mnt/home
  else
  ln -snf $HDRV /mnt/home
  fi
fi

# get the partition where the save storage is located (if other than booting device)
if grep -q noauto /proc/cmdline; then
CDEV=$(cat /mnt/live/tmp/cdev 2> /dev/null)
else
  # One lookup each, by mountpoint, instead of listing every mount and
  # grepping the list twice. rc.local is on the path to the login prompt.
  CDEV=$(findmnt -n -o SOURCE /mnt/live/memory/images/changes-exit 2>/dev/null)
  [ "$CDEV" ] || CDEV=$(findmnt -n -o SOURCE /mnt/live/memory/changes 2>/dev/null)
  CDEV=$(echo "$CDEV" | sed 's#[][]##g' | cut -d'/' -f3)
fi

# mount CDEV
if [ "$CDEV" ]; then
 if [ "$CDEV" != "memory" ] && [ "$CDEV" != "$hdrv" ]; then
 mkdir -p /mnt/$CDEV
 mount /dev/$CDEV /mnt/$CDEV
 fi
fi

ln -snf /mnt/live/memory/changes /live/cow
ln -snf /mnt/home /live/image
(if [ -f /mnt/live/tmp/changes-exit ]; then ln -snf /mnt/live/memory/images/changes-exit /mnt/saved; else ln -snf /mnt/live/memory/changes /mnt/saved; fi) &

if grep -qv noswap /proc/cmdline; then
  echo "LOAD SWAP"
  # The initrd already identified every swap partition with blkid and wrote
  # them into its fstab, which survives at /mnt/live/etc/fstab; read that
  # rather than have fdisk parse the partition table of every disk again.
  if [ -f /mnt/live/etc/fstab ]; then
  SWAPS=$(grep ' none swap ' /mnt/live/etc/fstab | cut -d' ' -f1 | tr '\n' ' ')
  else
  SWAPS=$(fdisk -l 2> /dev/null | grep ' Linux swap'  | cut -f 1 -d ' ' | tr '\n' ' ')
  fi
  for ONESWAP in $SWAPS
  do
    echo -n "Loading swap partition $ONESWAP..." >/dev/console
    swapon $ONESWAP

    [ $? -eq 0 ] && SWAPON="yes"
  done
fi

exit 0
